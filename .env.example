# Supabase — Project Settings → API
# The app runs on seed data when these are absent, so the first deploy works
# before the backend exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Server-only: never prefix with NEXT_PUBLIC_.
# Bypasses row level security — used by the ingestion jobs and Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Ingestion pipeline
ANTHROPIC_API_KEY=
ASSESS_MODEL=claude-sonnet-4-5
# Shared secret the Vercel cron sends as `Authorization: Bearer <value>`.
CRON_SECRET=

# Subscription gate. Set to "on" once the pay structure is decided.
NEXT_PUBLIC_PAYWALL=off

# Stripe (not wired yet — the schema is ready in migration 0004)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
